# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Generated artifacts (never track outputs)
# These MUST be anchored with a leading slash. An unanchored `reports/` matches
# results/traffic_ai/reports/ as well, which silently excluded the entire
# evidence base from the repository.
/data/
/reports/
/experiments/
/weights/
/plots/
/logs/
/predictions/
/videos/
/runs/

# results/ IS tracked on purpose: it holds the committed evidence (metrics,
# plots, annotated frames) that makes the repository reviewable without a GPU.
# Only the genuinely pathological artefacts are excluded:
results/**/manifest_*.json      # 31 MB of BDD100K metadata, regenerable by Phase 2
results/**/predictions.json     # 129 MB per-prediction dump from model.val()
# NOTE: logs/phase5.log IS committed, but only as a 60-line head. The full log
# is 9.2 MB and belongs to the run that did not reach the stratified evaluation.

# Environment
.venv/
venv/
.env

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
